{
    "name": "SCL Java 17 Development",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/scl",
    "customizations": {
        "jetbrains": {
            "backend": "IntelliJ",
            "plugins": [
                "com.intellij.database",
                "ru.adelf.idea.dotenv",
                "com.ktlwap.ldap-explorer",
                "com.intellij.ml.llm",
                "org.jetbrains.junie",
                "org.sonarlint.idea"
            ]
        },
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "vmware.vscode-boot-dev-pack",
                "dbaeumer.vscode-eslint",
                "sonarsource.sonarlint-vscode"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/git": {},
        "ghcr.io/devcontainers/features/node:1": {
        "version": "lts"
        },
        "ghcr.io/devcontainers/features/java:1": {
            "version": "17",
            "installMaven": "true",
            "installGradle": "false"
        }
    },
    "remoteUser": "vscode",
    "postCreateCommand": "sudo apt-get update && sudo apt-get upgrade -y && npm install"
}
